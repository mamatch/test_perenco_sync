# Config for pipeline/ (the candidate solution). Loaded automatically by
# pipeline/pipeline/config.py -- edit values here instead of exporting shell
# variables or passing them on the command line. A real environment variable
# of the same name still wins over anything set here. Nothing here is a real
# secret: CMMS_API_KEY is the mock CMMS's published demo key
# (docs/03_cmms_api.md), not a production credential.
#
# Path variables (SYSTEMREF_DB_PATH, SYSTEMREF_LITE_DIR, IOT_EXPORTS_DIR,
# AUDIT_DB_PATH) are commented out on purpose: pipeline/config.py's own
# defaults already resolve them relative to the repo root regardless of the
# process's working directory (`make sync` runs with cwd=pipeline/). If you
# uncomment one, give it an absolute path, not a relative one, or it will be
# read relative to wherever the pipeline happens to be started from.

# -- CMMS (mock_gmao) connector -----------------------------------------------
CMMS_BASE_URL=http://localhost:8080
CMMS_TENANT=PERENCO
CMMS_API_KEY=demo-key-global
CMMS_RATE_LIMIT_PER_MINUTE=50
CMMS_HTTP_MAX_RETRIES=6
CMMS_HTTP_TIMEOUT=10

# -- MDM (systemref_lite) -----------------------------------------------------
# SQLite file the pipeline reads directly (clients/mdm.py). Default:
# <repo_root>/mdm_data/systemref.sqlite3
# SYSTEMREF_DB_PATH=/absolute/path/to/mdm_data/systemref.sqlite3
#
# Where cmms_to_mdm.py dispatches `manage.py apply_sync_plan` (clients/mdadmin.py).
# Default: <repo_root>/systemref_lite
# SYSTEMREF_LITE_DIR=/absolute/path/to/systemref_lite

# -- IoT historian -------------------------------------------------------------
# Default: <repo_root>/iot_historian/exports
# IOT_EXPORTS_DIR=/absolute/path/to/iot_historian/exports

# -- Audit / observability store (pipeline/audit.py) ---------------------------
# Default: <repo_root>/pipeline/state/audit.sqlite3
# AUDIT_DB_PATH=/absolute/path/to/pipeline/state/audit.sqlite3

# -- Business thresholds (docs/02_business_rules.md, ARCHITECTURE_.md) ---------
# Destructive-only hard stop: a run that would archive more than this share of
# the active PLATFORM/SECTION tree gets its archives blocked (see DECISIONS.md #4).
ARCHIVE_RATIO_THRESHOLD=0.10

# -- Misc ------------------------------------------------------------------------
# Not yet read anywhere in the code -- reserved for a future dry-run mode.
SYNC_DRY_RUN=false
